# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/

# 环境变量与密钥（禁止提交真实 Key）
.env
.env.local

# 实验产物（评测集与报告保留，中间结果忽略）
eval/results/cache/
eval/results/raw/
*.log

# 内核同步副本的运行时生成物
server/data/chroma/
server/data/chroma-local/
server/data/chroma-minilm/
# 构建控制链路的数据目录；兼容 CLI/本地项目在各自目录下生成的 engine 数据
**/data/engine/
server/data/cache/
server/data/uploads/
server/data/attachments/
server/data/db/
server/data/p5-*/
# 历史版本的会话库路径（当前会话库位于 server/data/db/，保留以兼容旧部署）
server/data/sessions.db*
# 模型目录：便携布局 models/<模型短名>/（真实权重）随仓库分发；
# 仅忽略下载过程中的瞬态 hf 缓存布局（含软链接；下载完成即自动归位平铺并清理）
models/models--*/
models/blobs/
models/.locks/
models/CACHEDIR.TAG

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
.trae/

# 前端构建产物
web/dist/

# 前端依赖（本地安装）
web/node_modules/
.eslintcache

# TS 增量构建产物
*.tsbuildinfo

# Chroma 单写锁
**/data/.chroma-write.lock

# Vite 临时配置
*.timestamp-*.mjs

# 本地交付文档（不入库）
docs/知识构建过程说明.md
docs/系统设计文档.md

# 归档资料：设计方案、调研报告、历史评测与截图、诊断记录等非核心文件
/archive/

# 一键启动脚本的运行日志与临时截图
/logs/
/.screenshots/

# 重构工作区：日志、草稿与阶段性产物均不入库
.refactor_*

# CLI/本地项目的临时目录与运行时
.tmp-demo/

# 术语缓存：按当前语料与 Pack 运行时生成，不入库
data/terms/*.json
